# Nexaflow environment template
# Copy this file to .env and fill in local values.
# Never commit a real .env file.
# --- App ---
APP_NAME=Nexaflow
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
# --- Supabase (primary database) ---
# Dashboard → Project Settings → General (ref) + Database (password) + API (optional keys)
# Use Session pooler (port 5432) on Windows — direct db.*.supabase.co is often IPv6-only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_REGION=ap-south-1
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_NAME=postgres
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mirrored for tools that read POSTGRES_* / DATABASE_URL directly
POSTGRES_USER=postgres.YOUR_PROJECT_REF
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=postgres
POSTGRES_HOST=aws-0-ap-south-1.pooler.supabase.com
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Local Docker alternative (comment Supabase block and use these instead):
# POSTGRES_USER=nexusflow
# POSTGRES_PASSWORD=nexusflow_dev_password
# POSTGRES_DB=nexusflow
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://nexusflow:nexusflow_dev_password@localhost:5432/nexusflow
# SUPABASE_PROJECT_REF=
# --- Redis (cache + Celery broker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# true = run agents in-process (no Redis/worker needed). false = real Celery worker.
CELERY_TASK_ALWAYS_EAGER=true
# --- Auth (JWT) ---
# Generate a long random string before production.
JWT_SECRET_KEY=change_me_to_a_long_random_dev_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_HOURS=1
AUTH_RATE_LIMIT_PER_MINUTE=30
# true = mark new accounts verified immediately (use when SMTP_PASSWORD is empty).
AUTH_AUTO_VERIFY=false
# Optional: this email becomes admin on first register.
BOOTSTRAP_ADMIN_EMAIL=
# --- LLM ---
# Leave empty until you add a real key in your private .env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
# --- Agent run limits ---
AGENT_MAX_RESEARCH_RESULTS=5
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_MAX_RETRIES=2
# --- Human-in-the-loop ---
REQUIRE_APPROVAL_FOR_EMAIL=true
REQUIRE_APPROVAL_FOR_CRM=true
# --- Outbound email ---
# Gmail: enable 2-Step Verification, then create an App Password and paste it as SMTP_PASSWORD.
# Regular Gmail account passwords are rejected (SMTP 535).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# --- CRM (optional until integration phase) ---
CRM_BASE_URL=
CRM_API_KEY=
# --- n8n webhooks ---
N8N_WEBHOOK_SECRET=change_me_n8n_webhook_secret
# --- Billing (optional Stripe; local card-on-file works without these) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# --- Security ---
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
