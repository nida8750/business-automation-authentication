# NexusFlow environment template
# Copy this file to .env and fill in local values.
# Never commit a real .env file.
# --- App ---
APP_NAME=NexusFlow
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
# --- Frontend (Vite) ---
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
# --- Database (PostgreSQL) ---
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=nexusflow_dev_password
POSTGRES_DB=nexusflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nexusflow:nexusflow_dev_password@localhost:5432/nexusflow
# --- Redis (cache + Celery broker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# --- Auth (JWT) ---
# Generate a long random string before production.
JWT_SECRET_KEY=change_me_to_a_long_random_dev_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_HOURS=1
AUTH_RATE_LIMIT_PER_MINUTE=30
# Optional: this email becomes admin on first register.
BOOTSTRAP_ADMIN_EMAIL=
# --- LLM ---
# Leave empty until you add a real key in your private .env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
# --- Agent run limits ---
AGENT_MAX_RESEARCH_RESULTS=5
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_MAX_RETRIES=2
# --- Human-in-the-loop ---
REQUIRE_APPROVAL_FOR_EMAIL=true
REQUIRE_APPROVAL_FOR_CRM=true
# --- Outbound email (optional until integration phase) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# --- CRM (optional until integration phase) ---
CRM_BASE_URL=
CRM_API_KEY=
# --- n8n webhooks ---
N8N_WEBHOOK_SECRET=change_me_n8n_webhook_secret
# --- Security ---
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
